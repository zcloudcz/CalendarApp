@page "/"
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Generátor HTML Kalendáře</PageTitle>

<div class="container mt-5">
    <h1 class="mb-4">Generátor HTML Kalendáře</h1>

    <EditForm Model="@model" OnValidSubmit="@HandleSubmit" class="needs-validation">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Rok</label>
                <InputNumber @bind-Value="model.Year" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Měsíc</label>
                <InputSelect @bind-Value="model.Month" class="form-select">
                    <option value="1">Leden</option>
                    <option value="2">Únor</option>
                    <option value="3">Březen</option>
                    <option value="4">Duben</option>
                    <option value="5">Květen</option>
                    <option value="6">Červen</option>
                    <option value="7">Červenec</option>
                    <option value="8">Srpen</option>
                    <option value="9">Září</option>
                    <option value="10">Říjen</option>
                    <option value="11">Listopad</option>
                    <option value="12">Prosinec</option>
                </InputSelect>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Režim vykreslení</label>
            <InputSelect @bind-Value="model.RenderMode" class="form-select">
                <option value="0">Výchozí</option>
                <option value="1">Dva sloupce</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Region (volitelné)</label>
            <InputSelect @bind-Value="model.Region" class="form-select">
                <option value="">-- Nevybráno --</option>
                @foreach (var region in regions)
                {
                    <option value="@region">@region</option>
                }
            </InputSelect>
        </div>

        <!-- Template Selection Section -->
        <div class="mb-3">
            <label class="form-label">Šablona designu</label>
            <button type="button" class="btn btn-sm btn-info mb-2" @onclick="LoadTemplates">
                @if (templates.Any())
                {
                    <span>Načteno (@templates.Count)</span>
                }
                else
                {
                    <span>Načíst dostupné šablony</span>
                }
            </button>

            @if (templates.Any())
            {
                <div class="row g-3">
                    @foreach (var template in templates)
                    {
                        var isSelected = model.TemplateId == template.Id;
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 @(isSelected ? "border-primary" : "")"
                                 style="cursor: pointer;"
                                 @onclick="@(() => SelectTemplate(template.Id))">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        @if (isSelected)
                                        {
                                            <i class="bi bi-check-circle-fill text-primary"></i>
                                        }
                                        @template.Name
                                    </h6>
                                    <p class="card-text small text-muted">@template.Description</p>
                                    <div class="mt-2">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                @onclick:stopPropagation="true"
                                                @onclick="@(async () => await DownloadTemplate(template.Id))">
                                            <i class="bi bi-download"></i> Stáhnout
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(model.TemplateId))
                {
                    <div class="alert alert-info mt-3">
                        <strong>Vybraná šablona:</strong> @templates.FirstOrDefault(t => t.Id == model.TemplateId)?.Name
                        <button type="button" class="btn btn-sm btn-link" @onclick="@(() => model.TemplateId = null)">Zrušit výběr</button>
                    </div>
                }
            }
        </div>

        <!-- Special Days Management Section -->
        <div class="mb-3">
            <label class="form-label">Správa speciálních dnů</label>
            <button type="button" class="btn btn-sm btn-secondary mb-2" @onclick="LoadSpecialDays">
                Načíst speciální dny pro vybraný měsíc
            </button>

            @if (isLoadingSpecialDays)
            {
                <div class="text-center">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Načítám...</span>
                    </div>
                    <span class="ms-2">Načítám speciální dny...</span>
                </div>
            }

            @if (specialDaysLoaded && !isLoadingSpecialDays)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>Speciální dny v kalendáři (kliknutím vyloučíte)</strong>
                    </div>
                    <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                        @if (!allSpecialDays.Any())
                        {
                            <p class="text-muted">Pro tento měsíc nebyly nalezeny žádné speciální dny.</p>
                        }
                        else
                        {
                            @foreach (var day in allSpecialDays.OrderBy(d => d.Date))
                            {
                                var isExcluded = excludedDays.Any(e => e.Date == day.Date && e.Type == day.Type && e.Name == day.Name);
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@(!isExcluded)"
                                           @onchange="@(() => ToggleExclusion(day))"
                                           id="@($"day_{day.Date}_{day.Type}")">
                                    <label class="form-check-label" for="@($"day_{day.Date}_{day.Type}")">
                                        <strong>@day.Date</strong> - @day.Name
                                        <span class="badge bg-secondary">@GetTypeLabel(day.Type)</span>
                                        @if (!string.IsNullOrEmpty(day.Region))
                                        {
                                            <span class="badge bg-info">@day.Region</span>
                                        }
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <strong>Přidat vlastní speciální den</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <InputDate @bind-Value="newCustomDayDate" class="form-control"
                                       min="@($"{model.Year}-{model.Month:D2}-01")"
                                       max="@($"{model.Year}-{model.Month:D2}-{DateTime.DaysInMonth(model.Year, model.Month):D2}")" />
                            </div>
                            <div class="col-md-6">
                                <InputText @bind-Value="newCustomDayName" class="form-control" placeholder="Název speciálního dne" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary w-100" @onclick="AddCustomDay">Přidat</button>
                            </div>
                        </div>

                        @if (customDays.Any())
                        {
                            <div class="mt-3">
                                <strong>Přidané vlastní dny:</strong>
                                <ul class="list-group mt-2">
                                    @foreach (var day in customDays.OrderBy(d => d.Date))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><strong>@day.Date</strong> - @day.Name</span>
                                            <button type="button" class="btn btn-sm btn-danger" @onclick="@(() => RemoveCustomDay(day))">
                                                Odstranit
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Obrázek</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="imageOption" id="imageUrl" checked="@(!useImageFile)" @onchange="@(async () => { useImageFile = false; await ResetImageCrop(); })">
                <label class="form-check-label" for="imageUrl">
                    URL obrázku
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="imageOption" id="imageFile" checked="@useImageFile" @onchange="@(() => useImageFile = true)">
                <label class="form-check-label" for="imageFile">
                    Nahrát soubor
                </label>
            </div>

            @if (!useImageFile)
            {
                <InputText @bind-Value="model.ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                <small class="form-text text-muted">Nebo nechte prázdné pro výchozí sezónní obrázek. Doporučené rozměry: 1800×400px</small>
            }
            else
            {
                <InputFile OnChange="@HandleImageSelected" class="form-control" accept="image/*" />
                <small class="form-text text-muted">Doporučené rozměry: 1800×400px (panoramatický formát)</small>

                @if (!string.IsNullOrEmpty(imagePreviewUrl) && !showCropper)
                {
                    <div class="mt-3">
                        <div class="alert alert-info">
                            <strong>Náhled obrázku:</strong> Obrázek bude automaticky upraven na 1800×400px
                        </div>
                        <img src="@imagePreviewUrl" class="img-fluid mb-2" style="max-height: 200px;" />
                        <div>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="OpenCropper">
                                <i class="bi bi-crop"></i> Upravit výřez
                            </button>
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="ResetImageCrop">
                                <i class="bi bi-x-circle"></i> Zrušit
                            </button>
                        </div>
                    </div>
                }

                @if (showCropper)
                {
                    <div class="mt-3 border p-3 bg-light">
                        <h5>Upravit výřez obrázku</h5>
                        <p class="text-muted">Vyberte oblast obrázku, která se použije v kalendáři (poměr stran 4.5:1)</p>
                        <div style="max-height: 400px; overflow: hidden;">
                            <img id="cropperImage" src="@imagePreviewUrl" style="max-width: 100%;" />
                        </div>
                        <div class="mt-3">
                            <button type="button" class="btn btn-success" @onclick="ApplyCrop">
                                <i class="bi bi-check-circle"></i> Použít výřez
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseCropper">
                                <i class="bi bi-x-circle"></i> Zrušit
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Template</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="templateOption" id="defaultTemplate" checked="@(!useCustomTemplate)" @onchange="@(() => useCustomTemplate = false)">
                <label class="form-check-label" for="defaultTemplate">
                    Výchozí template
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="templateOption" id="customTemplate" checked="@useCustomTemplate" @onchange="@(() => useCustomTemplate = true)">
                <label class="form-check-label" for="customTemplate">
                    Vlastní template
                </label>
            </div>
            <small class="form-text text-muted">
                <a href="#" @onclick="DownloadDefaultTemplate" @onclick:preventDefault="true">Stáhnout výchozí šablonu</a> pro úpravu
            </small>

            @if (useCustomTemplate)
            {
                <div class="mb-2 mt-2">
                    <InputFile OnChange="@HandleTemplateSelected" class="form-control" accept=".txt,.html" />
                    @if (templateFile != null)
                    {
                        <small class="form-text text-success">Vybraný template: @templateFile.Name</small>
                    }
                </div>
                <small class="form-text text-muted">
                    Nebo upravte template přímo:
                </small>
                <InputTextArea @bind-Value="model.TemplateContent" class="form-control" rows="10" placeholder="Vložte HTML template..." />
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (isGenerating)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Generuji...</span>
                </div>
                <p class="mt-2">Generuji kalendář...</p>
            </div>
        }

        <div class="row gap-2 mb-3">
            <div class="col">
                <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@isGenerating">
                    @(isGenerating ? "Generuji..." : "Generovat kalendář")
                </button>
            </div>
            <div class="col">
                <button type="button" class="btn btn-success btn-lg w-100" disabled="@isGenerating" @onclick="HandleSubmitAndDownload">
                    @(isGenerating ? "Generuji..." : "Generovat a uložit")
                </button>
            </div>
        </div>
    </EditForm>
</div>

@code {
    // ===================================================================================
    // STATE MANAGEMENT
    // ===================================================================================

    // Model bound to form inputs
    private CalendarModel model = new() { Year = DateTime.Now.Year, Month = DateTime.Now.Month };

    // UI state flags
    private bool useImageFile = false;           // True if user wants to upload file vs. URL
    private bool useCustomTemplate = false;      // True if user wants custom template vs. default
    private bool isGenerating = false;           // True while waiting for API response
    private bool showCropper = false;            // True when Cropper.js UI is visible

    // File uploads
    private IBrowserFile? imageFile;             // User-uploaded image file
    private IBrowserFile? templateFile;          // User-uploaded template file

    // Image cropping state
    private string? imagePreviewUrl;             // Data URL for image preview
    private string? croppedImageBase64;          // Base64 of cropped image (1800x400px)

    // Data from API
    private List<string> regions = new();        // List of regions for dropdown (loaded on init)

    // Special days management
    private List<SpecialDayDto> allSpecialDays = new();      // All special days for the selected month
    private List<SpecialDayDto> excludedDays = new();        // Days that user wants to exclude
    private List<SpecialDayDto> customDays = new();          // Custom days added by user
    private bool specialDaysLoaded = false;                  // True if special days have been loaded
    private bool isLoadingSpecialDays = false;               // True while loading special days

    // Custom day input fields
    private DateTime? newCustomDayDate;                      // Date input for new custom day
    private string newCustomDayName = "";                    // Name input for new custom day

    // Template management
    private List<TemplateInfo> templates = new();            // List of available templates

    // Error handling
    private string? errorMessage;                // Error message to display to user

    // ===================================================================================
    // IMAGE HANDLING & CROPPING
    // ===================================================================================

    /// <summary>
    /// Handles image file selection by user.
    /// Reads the file into memory and creates a data URL for preview.
    /// Max file size: 10MB
    /// </summary>
    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        imageFile = e.File;
        croppedImageBase64 = null;  // Reset any previous crop
        showCropper = false;

        if (imageFile != null)
        {
            // Read file into memory and create data URL for preview
            var buffer = new byte[imageFile.Size];
            await imageFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            imagePreviewUrl = $"data:{imageFile.ContentType};base64,{base64}";
        }
        else
        {
            imagePreviewUrl = null;
        }
    }

    /// <summary>
    /// Opens the Cropper.js interface for selecting image crop area.
    /// Uses fixed aspect ratio of 4.5:1 (1800x400px).
    /// </summary>
    private async Task OpenCropper()
    {
        showCropper = true;
        StateHasChanged();
        await Task.Delay(100);  // Wait for DOM to render the <img> element
        await JSRuntime.InvokeVoidAsync("initializeCropper", "cropperImage", 4.5);
    }

    /// <summary>
    /// Applies the crop selection, generating a 1800x400px JPEG.
    /// The cropped image is stored as base64 and used for the calendar header.
    /// </summary>
    private async Task ApplyCrop()
    {
        croppedImageBase64 = await JSRuntime.InvokeAsync<string>("getCroppedImageBase64");
        await JSRuntime.InvokeVoidAsync("destroyCropper");
        showCropper = false;

        // Update preview to show the cropped result
        if (!string.IsNullOrEmpty(croppedImageBase64))
        {
            imagePreviewUrl = $"data:image/jpeg;base64,{croppedImageBase64}";
        }
    }

    private async Task CloseCropper()
    {
        await JSRuntime.InvokeVoidAsync("destroyCropper");
        showCropper = false;
    }

    private async Task ResetImageCrop()
    {
        if (showCropper)
        {
            await JSRuntime.InvokeVoidAsync("destroyCropper");
        }
        imageFile = null;
        imagePreviewUrl = null;
        showCropper = false;
        croppedImageBase64 = null;
    }

    private void HandleTemplateSelected(InputFileChangeEventArgs e)
    {
        templateFile = e.File;
    }

    // ===================================================================================
    // LIFECYCLE & INITIALIZATION
    // ===================================================================================

    /// <summary>
    /// Component initialization - fetches the list of regions from API.
    /// This populates the region dropdown on page load.
    /// Falls back to hardcoded list if API call fails.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<RegionsResponse>("https://localhost:7109/api/calendar/regions");
            if (response?.regions != null)
            {
                regions = response.regions;
            }
        }
        catch
        {
            // Fallback regions if API is unavailable
            regions = new List<string> { "Blansko", "Brno-město", "Brno-venkov", "Praha" };
        }
    }

    private async Task DownloadDefaultTemplate()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<TemplateResponse>("https://localhost:7109/api/calendar/default-template");
            if (response?.template != null)
            {
                var bytes = System.Text.Encoding.UTF8.GetBytes(response.template);
                var base64 = Convert.ToBase64String(bytes);
                await JSRuntime.InvokeVoidAsync("downloadFile", "template.html", base64, "text/html");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při stahování šablony: {ex.Message}";
        }
    }

    // ===================================================================================
    // SPECIAL DAYS MANAGEMENT
    // ===================================================================================

    /// <summary>
    /// Loads special days for the selected year, month, and region from the API.
    /// Populates the allSpecialDays list for user to manage (exclude or add custom days).
    /// </summary>
    private async Task LoadSpecialDays()
    {
        try
        {
            isLoadingSpecialDays = true;
            errorMessage = null;
            StateHasChanged();

            // Build API URL with query parameters
            var url = $"https://localhost:7109/api/calendar/special-days?year={model.Year}&month={model.Month}";
            if (!string.IsNullOrEmpty(model.Region))
            {
                url += $"&region={Uri.EscapeDataString(model.Region)}";
            }

            var response = await Http.GetFromJsonAsync<SpecialDaysResponse>(url);

            // Combine all types of special days into one list
            allSpecialDays = new List<SpecialDayDto>();
            if (response?.holidays != null) allSpecialDays.AddRange(response.holidays);
            if (response?.schoolHolidays != null) allSpecialDays.AddRange(response.schoolHolidays);
            if (response?.specialDays != null) allSpecialDays.AddRange(response.specialDays);
            if (response?.internationalDays != null) allSpecialDays.AddRange(response.internationalDays);

            specialDaysLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání speciálních dnů: {ex.Message}";
        }
        finally
        {
            isLoadingSpecialDays = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Toggles exclusion of a special day. When user unchecks a day, it's added to exclusions.
    /// When they check it again, it's removed from exclusions.
    /// </summary>
    private void ToggleExclusion(SpecialDayDto day)
    {
        var existing = excludedDays.FirstOrDefault(e =>
            e.Date == day.Date && e.Type == day.Type && e.Name == day.Name);

        if (existing != null)
        {
            // Day is currently excluded - remove from exclusions (user wants to include it)
            excludedDays.Remove(existing);
        }
        else
        {
            // Day is not excluded - add to exclusions (user wants to remove it)
            excludedDays.Add(day);
        }
    }

    /// <summary>
    /// Adds a new custom special day based on user input.
    /// Validates that date and name are provided.
    /// </summary>
    private void AddCustomDay()
    {
        if (!newCustomDayDate.HasValue || string.IsNullOrWhiteSpace(newCustomDayName))
        {
            errorMessage = "Vyplňte datum a název speciálního dne.";
            return;
        }

        // Create new custom day
        var customDay = new SpecialDayDto
        {
            Date = newCustomDayDate.Value.ToString("yyyy-MM-dd"),
            Name = newCustomDayName.Trim(),
            Type = "custom"
        };

        customDays.Add(customDay);

        // Clear input fields
        newCustomDayDate = null;
        newCustomDayName = "";
        errorMessage = null;
    }

    /// <summary>
    /// Removes a custom special day from the list.
    /// </summary>
    private void RemoveCustomDay(SpecialDayDto day)
    {
        customDays.Remove(day);
    }

    // ===================================================================================
    // TEMPLATE MANAGEMENT
    // ===================================================================================

    /// <summary>
    /// Loads available templates from the API.
    /// </summary>
    private async Task LoadTemplates()
    {
        try
        {
            errorMessage = null;
            var response = await Http.GetFromJsonAsync<TemplatesResponse>("https://localhost:7109/api/calendar/templates");
            if (response?.templates != null)
            {
                templates = response.templates;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání šablon: {ex.Message}";
        }
    }

    /// <summary>
    /// Selects a template by ID.
    /// </summary>
    private void SelectTemplate(string templateId)
    {
        model.TemplateId = templateId;
        // Disable custom template mode when selecting from library
        useCustomTemplate = false;
    }

    /// <summary>
    /// Downloads a template for editing.
    /// </summary>
    private async Task DownloadTemplate(string templateId)
    {
        try
        {
            var response = await Http.GetAsync($"https://localhost:7109/api/calendar/templates/{templateId}/download");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                var fileName = $"sablona-{templateId}.html";
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64, "text/html");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při stahování šablony: {ex.Message}";
        }
    }

    /// <summary>
    /// Returns a user-friendly label for special day types.
    /// Used for displaying badges in the UI.
    /// </summary>
    private string GetTypeLabel(string type)
    {
        return type switch
        {
            "holiday" => "Státní svátek",
            "schoolHoliday" => "Prázdniny",
            "specialDay" => "Významný den",
            "internationalDay" => "Mezinárodní den",
            "custom" => "Vlastní",
            _ => type
        };
    }

    private async Task HandleSubmit()
    {
        try
        {
            isGenerating = true;
            errorMessage = null;
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(model.Year.ToString()), "Year");
            content.Add(new StringContent(model.Month.ToString()), "Month");
            content.Add(new StringContent(((int)model.RenderMode).ToString()), "RenderMode");

            if (!string.IsNullOrEmpty(model.Region))
                content.Add(new StringContent(model.Region), "Region");

            // Add excluded days as JSON
            if (excludedDays.Any())
            {
                var excludedJson = System.Text.Json.JsonSerializer.Serialize(excludedDays);
                content.Add(new StringContent(excludedJson), "ExcludedDays");
            }

            // Add custom days as JSON
            if (customDays.Any())
            {
                var customJson = System.Text.Json.JsonSerializer.Serialize(customDays);
                content.Add(new StringContent(customJson), "CustomDays");
            }

            if (useImageFile && !string.IsNullOrEmpty(croppedImageBase64))
            {
                // Use cropped image
                var imageBytes = Convert.FromBase64String(croppedImageBase64);
                var imageContent = new ByteArrayContent(imageBytes);
                imageContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");
                content.Add(imageContent, "ImageFile", "cropped-image.jpg");
            }
            else if (useImageFile && imageFile != null)
            {
                // Use original image if not cropped
                var imageContent = new StreamContent(imageFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                imageContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(imageFile.ContentType);
                content.Add(imageContent, "ImageFile", imageFile.Name);
            }
            else if (!string.IsNullOrEmpty(model.ImageUrl))
            {
                content.Add(new StringContent(model.ImageUrl), "ImageUrl");
            }

            // Template handling - priority: custom file > custom content > template ID
            if (useCustomTemplate)
            {
                if (templateFile != null)
                {
                    var templateContent = new StreamContent(templateFile.OpenReadStream(maxAllowedSize: 1024 * 1024));
                    templateContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("text/plain");
                    content.Add(templateContent, "TemplateFile", templateFile.Name);
                }
                else if (!string.IsNullOrEmpty(model.TemplateContent))
                {
                    content.Add(new StringContent(model.TemplateContent), "TemplateContent");
                }
            }
            else if (!string.IsNullOrEmpty(model.TemplateId))
            {
                content.Add(new StringContent(model.TemplateId), "TemplateId");
            }

            var response = await Http.PostAsync("https://localhost:7109/api/calendar/generate", content);

            if (response.IsSuccessStatusCode)
            {
                var html = await response.Content.ReadAsStringAsync();
                var bytes = System.Text.Encoding.UTF8.GetBytes(html);
                var base64 = Convert.ToBase64String(bytes);

                // Open in new window
                await JSRuntime.InvokeVoidAsync("openCalendarInNewWindow", base64);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObject = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    errorMessage = errorObject?.error ?? $"Chyba při generování: {response.StatusCode}";
                }
                catch
                {
                    errorMessage = $"Chyba při generování: {response.StatusCode}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Handles calendar generation with automatic download (saves to user's Downloads folder).
    /// Similar to HandleSubmit but triggers file download instead of opening in new window.
    /// </summary>
    private async Task HandleSubmitAndDownload()
    {
        try
        {
            isGenerating = true;
            errorMessage = null;
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(model.Year.ToString()), "Year");
            content.Add(new StringContent(model.Month.ToString()), "Month");
            content.Add(new StringContent(((int)model.RenderMode).ToString()), "RenderMode");

            if (!string.IsNullOrEmpty(model.Region))
                content.Add(new StringContent(model.Region), "Region");

            // Add excluded days as JSON
            if (excludedDays.Any())
            {
                var excludedJson = System.Text.Json.JsonSerializer.Serialize(excludedDays);
                content.Add(new StringContent(excludedJson), "ExcludedDays");
            }

            // Add custom days as JSON
            if (customDays.Any())
            {
                var customJson = System.Text.Json.JsonSerializer.Serialize(customDays);
                content.Add(new StringContent(customJson), "CustomDays");
            }

            if (useImageFile && !string.IsNullOrEmpty(croppedImageBase64))
            {
                var imageBytes = Convert.FromBase64String(croppedImageBase64);
                var imageContent = new ByteArrayContent(imageBytes);
                imageContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");
                content.Add(imageContent, "ImageFile", "cropped-image.jpg");
            }
            else if (useImageFile && imageFile != null)
            {
                var imageContent = new StreamContent(imageFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                imageContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(imageFile.ContentType);
                content.Add(imageContent, "ImageFile", imageFile.Name);
            }
            else if (!string.IsNullOrEmpty(model.ImageUrl))
            {
                content.Add(new StringContent(model.ImageUrl), "ImageUrl");
            }

            // Template handling - priority: custom file > custom content > template ID
            if (useCustomTemplate)
            {
                if (templateFile != null)
                {
                    var templateContent = new StreamContent(templateFile.OpenReadStream(maxAllowedSize: 1024 * 1024));
                    templateContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("text/plain");
                    content.Add(templateContent, "TemplateFile", templateFile.Name);
                }
                else if (!string.IsNullOrEmpty(model.TemplateContent))
                {
                    content.Add(new StringContent(model.TemplateContent), "TemplateContent");
                }
            }
            else if (!string.IsNullOrEmpty(model.TemplateId))
            {
                content.Add(new StringContent(model.TemplateId), "TemplateId");
            }

            var response = await Http.PostAsync("https://localhost:7109/api/calendar/generate", content);

            if (response.IsSuccessStatusCode)
            {
                var html = await response.Content.ReadAsStringAsync();
                var bytes = System.Text.Encoding.UTF8.GetBytes(html);
                var base64 = Convert.ToBase64String(bytes);

                // Generate filename based on month and year
                var monthName = new DateTime(model.Year, model.Month, 1).ToString("MMMM", new System.Globalization.CultureInfo("cs-CZ"));
                var filename = $"{monthName}-{model.Year}.html";

                // Download file instead of opening in new window
                await JSRuntime.InvokeVoidAsync("downloadCalendarFile", filename, base64);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObject = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent);
                    errorMessage = errorObject?.error ?? $"Chyba při generování: {response.StatusCode}";
                }
                catch
                {
                    errorMessage = $"Chyba při generování: {response.StatusCode}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    public class CalendarModel
    {
        [Required]
        [Range(2000, 2100)]
        public int Year { get; set; }

        [Required]
        [Range(1, 12)]
        public int Month { get; set; }

        public string? ImageUrl { get; set; }
        public string? TemplateContent { get; set; }
        public string? TemplateId { get; set; }
        public int RenderMode { get; set; }
        public string? Region { get; set; }
    }

    /// <summary>
    /// DTO for special days - matches the backend SpecialDayDto class.
    /// Used for API communication and managing excluded/custom days.
    /// </summary>
    public class SpecialDayDto
    {
        public required string Date { get; set; }
        public string? EndDate { get; set; }
        public required string Name { get; set; }
        public required string Type { get; set; }
        public string? Region { get; set; }
    }

    public class ErrorResponse
    {
        public string? error { get; set; }
    }

    public class RegionsResponse
    {
        public List<string>? regions { get; set; }
    }

    public class TemplateResponse
    {
        public string? template { get; set; }
    }

    /// <summary>
    /// Response model for special days API endpoint.
    /// Contains all types of special days for a given month.
    /// </summary>
    public class SpecialDaysResponse
    {
        public List<SpecialDayDto>? holidays { get; set; }
        public List<SpecialDayDto>? schoolHolidays { get; set; }
        public List<SpecialDayDto>? specialDays { get; set; }
        public List<SpecialDayDto>? internationalDays { get; set; }
    }

    /// <summary>
    /// Response model for templates API endpoint.
    /// </summary>
    public class TemplatesResponse
    {
        public List<TemplateInfo>? templates { get; set; }
    }

    /// <summary>
    /// Template metadata.
    /// </summary>
